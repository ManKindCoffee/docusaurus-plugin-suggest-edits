{
  "name": "docusaurus-plugin-suggest-edits",
  "version": "0.1.0",
  "description": "Let readers suggest edits to Docusaurus docs from the page itself. Suggestions arrive as pull requests.",
  "license": "MIT",
  "author": "M.Villa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManKindCoffee/docusaurus-plugin-suggest-edits.git",
    "directory": "packages/docusaurus-plugin-suggest-edits"
  },
  "homepage": "https://github.com/ManKindCoffee/docusaurus-plugin-suggest-edits#readme",
  "bugs": "https://github.com/ManKindCoffee/docusaurus-plugin-suggest-edits/issues",
  "keywords": ["docusaurus", "docusaurus-plugin", "suggest-edits", "mdx", "documentation", "pull-request"],
  "engines": {"node": ">=20"},
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server/index.mjs",
    "./server/azure-functions": "./src/server/azure-functions.mjs",
    "./server/node": "./src/server/node.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.mjs"
  ],
  "scripts": {
    "test": "node --test 'src/server/*.test.mjs'"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3",
    "@docusaurus/plugin-content-docs": "^3",
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@docusaurus/utils-validation": "^3",
    "diff": "^9.0.0",
    "rehype-katex": "1.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  }
}
