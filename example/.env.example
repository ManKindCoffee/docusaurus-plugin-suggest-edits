# Which Git host: github or azure-devops
SUGGEST_ADAPTER=github

# GitHub
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_TARGET_BRANCH=main

# Azure DevOps
ADO_ORG=
ADO_PROJECT=
ADO_REPO=
ADO_TARGET_BRANCH=main
# How to sign in: pat, managed-identity (in Azure) or azure-cli (local testing, uses `az login`)
ADO_AUTH=pat
ADO_PAT=

# Local Node server only
SUGGEST_ALLOWED_ORIGIN=http://localhost:3000